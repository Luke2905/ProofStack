# String de conexão MySQL (Local ou Cloud na Vercel: TiDB Cloud, PlanetScale, Railway, Aiven, Hostinger, etc.)
# Para bancos em nuvem que exigem SSL, adicione ?ssl=true ao final da URL
DATABASE_URL="mysql://root:@localhost:3306/portifoliohub"

# Chave secreta para assinatura e verificação dos tokens JWT (HS256 - 7 dias)
JWT_SECRET="altere_para_uma_chave_secreta_segura_em_producao"
